{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/.ai/schemas/development-registry.schema.json",
  "title": "Nexora Development Unit Registry",
  "type": "object",
  "required": ["schema_version", "project", "rule", "units"],
  "properties": {
    "schema_version": { "type": "string" },
    "project": { "const": "Nexora" },
    "rule": { "type": "string", "minLength": 1 },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "development-unit.schema.json" }
    }
  },
  "additionalProperties": false
}
