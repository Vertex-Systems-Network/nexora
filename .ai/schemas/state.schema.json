{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexora.local/.ai/schemas/state.schema.json",
  "title": "Nexora AI Execution State",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "base_branch",
    "base_sha",
    "source_release",
    "source_status",
    "target_status",
    "current_stage",
    "next_actions",
    "next_stage",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "project": { "const": "Nexora" },
    "control_plane_revision": { "type": "integer", "minimum": 1 },
    "control_plane_branch": { "type": "string" },
    "base_branch": { "type": "string", "minLength": 1 },
    "base_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "last_verified_source_sha": {
      "oneOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      ]
    },
    "source_release": { "type": "string", "minLength": 1 },
    "installer_protocol": { "type": "string" },
    "source_generation": { "type": "string" },
    "source_status": { "$ref": "#/$defs/status" },
    "target_status": { "$ref": "#/$defs/status" },
    "current_stage": { "$ref": "#/$defs/stage" },
    "completed_control_stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string" },
          "status": { "$ref": "#/$defs/status" },
          "evidence": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "current_target": { "type": "object" },
    "blocker": {
      "type": "object",
      "required": ["category", "summary"],
      "properties": {
        "category": { "type": "string" },
        "summary": { "type": "string" },
        "guardrail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "next_actions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "next_stage": {
      "type": "object",
      "required": ["id", "name", "advance_when"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "advance_when": { "type": "string" }
      },
      "additionalProperties": false
    },
    "verification_required": { "type": "object" },
    "roadmap_sources": { "type": "array", "items": { "type": "string" } },
    "phase_1_scope": { "type": "string" },
    "phase_2_scope": { "type": "string" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "status": {
      "enum": [
        "SOURCE_DONE",
        "TARGET_VERIFIED",
        "PARTIAL",
        "BLOCKED",
        "PLANNED",
        "EXTERNAL",
        "DEFERRED_CERTIFICATION"
      ]
    },
    "stage": {
      "type": "object",
      "required": ["id", "name", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "legacy_aliases": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
