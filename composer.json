{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nexora/platform",
    "type": "project",
    "description": "Nexora secure modular application platform.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": ">=8.3 <8.5",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-zip": "*",
        "inertiajs/inertia-laravel": "^3.3",
        "laravel/framework": "^13.24",
        "laravel/tinker": "^3.0",
        "nikic/php-parser": "^5.7"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "npm ci",
            "npm run build",
            "@php artisan optimize:clear"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "test:unit": [
            "@php artisan test --testsuite=Unit"
        ],
        "test:feature": [
            "@php artisan test --testsuite=Feature"
        ],
        "quality": [
            "@php artisan test",
            "@php vendor/bin/pint --test"
        ],
        "certify:source": [
            "@php scripts/certify-release.php --source-only"
        ],
        "certify": [
            "@php scripts/certify-release.php"
        ],
        "certify:final-status": [
            "@php scripts/final-closure-status.php"
        ],
        "certify:final": [
            "@php scripts/final-target-run.php --final"
        ],
        "diagnostics:target": [
            "@php scripts/target-diagnostics.php"
        ],
        "diagnostics:target:full": [
            "@php scripts/target-diagnostics.php --install-deps --full"
        ],
        "certify:dependencies": [
            "@php scripts/dependency-contract-verify.php --strict-locks"
        ],
        "audit:dependencies": [
            "@php scripts/dependency-audit.php"
        ],
        "certify:target": [
            "@php scripts/target-runtime-run.php"
        ],
        "certify:target:full": [
            "@php scripts/target-runtime-run.php --full"
        ],
        "certify:bootstrap": [
            "@php scripts/target-environment-bootstrap.php --write"
        ],
        "certify:target:resume": [
            "@php scripts/target-runtime-run.php --resume-latest"
        ],
        "verify:target-evidence": [
            "@php scripts/target-runtime-evidence-verify.php"
        ],
        "certify:n1-c1": [
            "@php scripts/n1-c1-dependency-certify.php"
        ],
        "certify:n1-c1:install": [
            "@php scripts/n1-c1-dependency-certify.php --install-deps"
        ],
        "certify:n1-c2": [
            "@php scripts/n1-c2-laravel-runtime-certify.php"
        ],
        "verify:n1-c2": [
            "@php scripts/n1-c2-evidence-verify.php"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "platform-check": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "suggest": {
        "mongodb/laravel-mongodb": "Official MongoDB integration for modules that use MongoDB-backed Eloquent/query features.",
        "predis/predis": "Pure-PHP Redis client fallback when the PhpRedis extension is unavailable.",
        "aws/aws-sdk-php": "AWS SDK connector for DynamoDB and future AWS data-service adapters.",
        "league/flysystem-aws-s3-v3": "S3-compatible object-storage adapter for horizontally scaled Nexora media/backups."
    }
}
