{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "php scripts/pkg1-build.php",
        "typecheck": "tsc --noEmit",
        "verify:inertia": "php scripts/inertia-frontend-contract-verify.php",
        "test": "vitest run",
        "test:watch": "vitest",
        "quality": "npm run typecheck && npm run test && npm run build && npm run verify:build",
        "certify:source": "php scripts/certify-release.php --source-only",
        "certify": "php scripts/certify-release.php",
        "certify:browser-evidence": "php scripts/browser-evidence-verify.php",
        "verify:build": "php scripts/performance-build-verify.php",
        "certify:final-status": "php scripts/final-closure-status.php",
        "certify:final": "php scripts/final-target-run.php --final",
        "diagnostics:target": "php scripts/target-diagnostics.php",
        "diagnostics:target:full": "php scripts/target-diagnostics.php --install-deps --full",
        "verify:dependencies": "php scripts/dependency-contract-verify.php --strict-locks",
        "audit:dependencies": "php scripts/dependency-audit.php",
        "certify:target": "php scripts/target-runtime-run.php",
        "certify:target:full": "php scripts/target-runtime-run.php --full",
        "certify:bootstrap": "php scripts/target-environment-bootstrap.php --write",
        "certify:target:resume": "php scripts/target-runtime-run.php --resume-latest",
        "verify:target-evidence": "php scripts/target-runtime-evidence-verify.php",
        "certify:intake": "php scripts/target-prerequisite-intake.php",
        "review:locks": "php scripts/dependency-lock-review.php",
        "verify:reviewed-locks": "php scripts/dependency-lock-review.php --verify-attestation",
        "certify:target:orchestrate": "php scripts/target-certification-orchestrator.php",
        "certify:target:orchestrate:full": "php scripts/target-certification-orchestrator.php --full",
        "certify:n1-c1": "php scripts/n1-c1-dependency-certify.php",
        "certify:n1-c1:install": "php scripts/n1-c1-dependency-certify.php --install-deps",
        "certify:n1-c2": "php scripts/n1-c2-laravel-runtime-certify.php",
        "verify:n1-c2": "php scripts/n1-c2-evidence-verify.php",
        "certify:n1-c3": "php scripts/n1-c3-database-matrix-certify.php",
        "certify:n1-c4": "php scripts/n1-c4-operations-certify.php",
        "certify:n1-c5": "php scripts/n1-c5-browser-performance-certify.php",
        "prepare:n1-c5-evidence": "php scripts/n1-c5-evidence-prepare.php",
        "diagnostics:n1-c1:frontend": "php scripts/n1-c1-frontend-build-doctor.php --run --write --json",
        "refresh:locks": "php scripts/dependency-lock-refresh.php --confirm=REFRESH",
        "promote:locks": "php scripts/dependency-lock-promote.php",
        "recover:locks": "php scripts/dependency-lock-promotion-recover.php --confirm=ROLLBACK",
        "close:pkg1": "php scripts/pkg1-usable-closure.php",
        "smoke:pkg1": "php scripts/pkg1-usable-smoke.php",
        "verify:pkg1": "php scripts/pkg1-closure-evidence-verify.php",
        "finalize:pkg1": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pkg1-finalize-login-smoke.ps1",
        "bootstrap:composer": "php scripts/composer-bootstrap.php",
        "build:raw": "tsc --noEmit && vite build",
        "verify:candidate-supply-chain": "php scripts/n1-target-dependency-candidate-supply-chain-contract-verify.php",
        "status:pkg1": "php scripts/pkg1-status.php",
        "run:pkg1": "php scripts/pkg1-run.php",
        "verify:pkg1-launcher": "php scripts/pkg1-launcher-contract-verify.php",
        "verify:windows-npm-bridge": "php scripts/n1-target-windows-npm-bridge-contract-verify.php",
        "verify:npm-bundled-integrity": "php scripts/n1-target-npm-bundled-integrity-contract-verify.php",
        "verify:semantic-lock-reproducibility": "php scripts/n1-target-semantic-lock-reproducibility-contract-verify.php",
        "verify:typescript-depth": "php scripts/n1-target-typescript-depth-contract-verify.php",
        "dev:check": "php scripts/development-readiness.php --full"
    },
    "dependencies": {
        "@inertiajs/react": "^3.6.1",
        "@inertiajs/vite": "^3.6.1",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-aria-components": "^1.20.0",
        "tailwind-merge": "^3.6.0",
        "lucide-react": "^0.468.0",
        "@internationalized/date": "^3.9.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.5",
        "jsdom": "^26.1.0",
        "laravel-vite-plugin": "^3.1.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^5.9.0",
        "vite": "^8.2.0",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=22 <25",
        "npm": ">=10 <11"
    },
    "packageManager": "npm@10.9.2"
}
